# Copy to .env.local for local dev; set the same keys in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values. Comments sit on their own lines so values paste cleanly.

# --- Admin security (required)
# Encrypts authenticator secrets at rest. Generate once and never change it:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# One-time code to create the first owner account at /admin (32+ random characters, e.g. `openssl rand -hex 24`).
# After the owner exists it does nothing; you can delete it.
ADMIN_BOOTSTRAP_TOKEN=
# Optional extra secret mixed into password hashes (set once, never change)
PASSWORD_PEPPER=

# --- WhatsApp bot + alerts: ON HOLD (moving to qworks). Leave unset/0 for now.
WHATSAPP_ENABLED=0

# --- Meta WhatsApp Cloud API (only needed once WHATSAPP_ENABLED=1)
# Permanent System User token for production (the API Setup token expires in 24 h)
WHATSAPP_TOKEN=
# WhatsApp -> API Setup -> Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# Any long random string; paste the same value into the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Optional
GRAPH_API_VERSION=v21.0
# Language code the message templates were approved in
TEMPLATE_LANG=en

# --- Claude
ANTHROPIC_API_KEY=
# Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=low

# --- Database: use the POOLED connection string (Neon "-pooler" host / Supabase port 6543)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/qoui?sslmode=require

# --- Betty (only needed once WHATSAPP_ENABLED=1; M-Pesa details are set in Admin → Settings)
# Betty's personal WhatsApp in E.164 (+254...). Must NOT be the business number.
BETTY_PHONE=
# Optional fallbacks if Admin → Settings → M-Pesa is empty
BETTY_MPESA_NUMBER=
BETTY_MPESA_NAME=
# Optional override; otherwise the deposit set in Admin → Settings is used
DEPOSIT_AMOUNT=

# --- Website booking (optional)
# Salt for hashing visitor IPs used in rate limiting (falls back to CRON_SECRET)
IP_HASH_SALT=
# Extra allowed origins for booking POSTs, comma separated (the site's own domain is always allowed)
ALLOWED_ORIGINS=

# --- Cron: long random string; Vercel sends it as "Authorization: Bearer <value>"
CRON_SECRET=
